  "migration_assets": [
    {
      "path": "terminology/zitingjing-migration-map.json",
      "asset_id": "zitingjing-terminology-migration-v1",
      "purpose": "恢复旧本地术语库中的紫庭相关term id、原字形、页码、定义、notes与aliases",
      "canonical_catalog": false
    },
    {
      "path": "terminology/ncl06604-legacy-reconciliation-map.json",
      "asset_id": "ncl06604-legacy-reconciliation-map",
      "purpose": "旧NCL-06604术语记录与当前页级影像复核结果去重/对账",
      "canonical_catalog": false
    },
    {
      "path": "terminology/legacy-recovery-manifest.json",
      "asset_id": "taiyi-legacy-terminology-recovery-manifest-v1",
      "purpose": "对全部stable terminology建立可逆旧terminology.json恢复映射；旧ID/定义/notes/页码未知时保持null",
      "canonical_catalog": false
    },
    {
      "path": "terminology/zitingjing-legacy-scan-recovery.json",
      "asset_id": "zitingjing-prior-workflow-recovery-v2",
      "purpose": "分离记录两件事：用户确认研易楼明钞本此前已扫描；以及旧kentang2017/kintaiyi中明确标注《统宗》卷六来源的九星代码残留。后者不得冒充研易楼本逐字见证。",
      "canonical_catalog": false
    }
  ],
  "supporting_assets": [
    {
      "path": "terminology/jinjing-v4-aliases.json",
      "asset_id": "jinjing-v4-source-form-aliases",
