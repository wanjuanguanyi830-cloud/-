      "source_volume": 3,
      "definition": "由文昌囚太乙及大小将关系，或客目临太乙位置及客将关系组成的复合格局。"
    },
    {
      "key": "sigu_du",
      "preferred_term": "四郭杜",
      "aliases": ["四郭杜"],
      "source_variants": ["四郭社"],
      "term_type": "jinjing_pattern",
      "source_profile": "jinjing_geju",
      "source_volume": 3,
      "definition": "客参与文昌并、主大与客大并，并兼掩/迫/关/格/提挟等条件组成的复合格局。",
