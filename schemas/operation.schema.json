{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/taiyi/operation.schema.json",
  "title":"Taiyi public operation registry",
  "type":"object",
  "required":["schema_version","registry_id","operations"],
  "properties":{
    "schema_version":{"type":"string"},
    "registry_id":{"type":"string"},
    "operations":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["name","domain","rule_ids","runtime","status"],
        "properties":{
          "name":{"type":"string"},
          "domain":{"type":"string"},
          "rule_ids":{"type":"array","items":{"type":"string"}},
          "runtime":{"type":["string","null"]},
          "status":{"type":"string"}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":true
}
